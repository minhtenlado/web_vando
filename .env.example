# ===== DATABASE =====
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ===== ADMIN AUTH =====
# Mật khẩu đăng nhập Admin Panel (nên dùng mật khẩu mạnh >= 16 ký tự)
ADMIN_PASSWORD=your_strong_password_here

# Secret dùng để ký session token (64 ký tự hex ngẫu nhiên)
# Tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_64_char_hex_secret_here

# ===== EXTERNAL SERVICES =====
# Web3Forms Access Key (dùng để gửi email từ form liên hệ)
# Đăng ký tại: https://web3forms.com/
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# ===== VERCEL BLOB STORAGE (tự động có trên Vercel) =====
# BLOB_READ_WRITE_TOKEN=auto_generated_by_vercel
